<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFDF4">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AAZ SMS Bridge" android:textStyle="bold" android:textSize="28sp" android:textColor="#111111" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SIM SMS → AAZ Connect" android:textSize="15sp" android:textColor="#555555" android:layout_marginBottom="22dp" />
    <EditText android:id="@+id/endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Base API URL (https://.../v1)" android:inputType="textUri" />
    <EditText android:id="@+id/secret" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Bridge secret" android:inputType="textPassword" />
    <EditText android:id="@+id/deviceId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Device ID (e.g. office-sim-01)" />
    <CheckBox android:id="@+id/smartFilter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable local smart filter" android:layout_marginTop="12dp" />
    <EditText android:id="@+id/blockKeywords" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Block entire message keywords" android:minLines="2" android:inputType="textMultiLine" />
    <EditText android:id="@+id/removeKeywords" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Remove only these keywords" android:minLines="2" android:inputType="textMultiLine" />
    <EditText android:id="@+id/removeSentenceKeywords" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Remove sentences containing these keywords" android:minLines="2" android:inputType="textMultiLine" />
    <EditText android:id="@+id/removeLineKeywords" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Remove lines containing these keywords" android:minLines="2" android:inputType="textMultiLine" />
    <Button android:id="@+id/manageSenderRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MANAGE SENDER-SPECIFIC RULES" />
    <TextView android:id="@+id/senderRuleSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No sender-specific rules." android:textColor="#555555" android:layout_marginBottom="8dp" />
    <Button android:id="@+id/manageKeywordForward" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KEYWORD BASED FORWARD" />
    <TextView android:id="@+id/keywordForwardSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No forwarding keywords." android:textColor="#555555" android:layout_marginBottom="8dp" />
    <Button android:id="@+id/manageKeywordRules" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MANAGE KEYWORD-SPECIFIC RULES" />
    <TextView android:id="@+id/keywordRuleSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No keyword-specific rules." android:textColor="#555555" android:layout_marginBottom="8dp" />
    <CheckBox android:id="@+id/enabled" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable SMS forwarding" android:checked="false" android:layout_marginTop="12dp" />
    <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SAVE SETTINGS" android:layout_marginTop="16dp" />
    <Button android:id="@+id/test" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEND TEST MESSAGE" />
    <Button android:id="@+id/viewDeliveryLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VIEW DELIVERY LOG" />
    <Button android:id="@+id/backgroundSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BACKGROUND RELIABILITY SETTINGS" />
    <TextView android:id="@+id/backgroundStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Checking battery optimization…" android:textColor="#7A4E00" android:layout_marginBottom="8dp" />
    <CheckBox android:id="@+id/alwaysActive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep bridge always active (recommended)" android:checked="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Shows a permanent ‘AAZ SMS Bridge active’ notification." android:textColor="#555555" android:layout_marginBottom="8dp" />
    <CheckBox android:id="@+id/healthCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enable diagnostic health-check delay history" android:checked="false" />
    <Button android:id="@+id/viewInactivityLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VIEW HEALTH-CHECK DELAY HISTORY" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Disabled until settings are saved." android:textColor="#555555" android:layout_marginTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sender routing and destination groups are controlled by WordPress Admin." android:textColor="#7A4E00" android:layout_marginTop="20dp" />
  </LinearLayout>
</ScrollView>
